{"version":3,"kind":"Notebook","sha256":"d6eaa31f909f3421f80a80a3291657ee79c83df026d5338239c36f72fc0fa549","slug":"sims.null-pvalue","location":"/sims/null_pvalue.ipynb","dependencies":[],"frontmatter":{"title":"Interactive: the p-value is the tail of the null distribution","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3"},"authors":[{"nameParsed":{"literal":"CSUB Department of Mathematics","given":"CSUB Department","non_dropping_particle":"of","family":"Mathematics"},"name":"CSUB Department of Mathematics","id":"contributors-Users\\ayatawara\\Documents\\1- Research next generation\\CSU LIFT\\coordinator\\math2200\\book\\myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-SA-4.0","url":"https://creativecommons.org/licenses/by-sa/4.0/","name":"Creative Commons Attribution Share Alike 4.0 International","free":true,"CC":true},"code":{"id":"MIT","url":"https://opensource.org/licenses/MIT","name":"MIT License","free":true,"osi":true}},"github":"https://github.com/csub-math/lift-math2200","numbering":{"equation":{"enabled":false},"heading_1":{"enabled":true},"heading_2":{"enabled":true},"heading_3":{"enabled":true},"heading_4":{"enabled":true},"heading_5":{"enabled":true},"heading_6":{"enabled":true},"title":{"offset":1}},"exports":[{"format":"ipynb","filename":"null_pvalue.ipynb","url":"/coursebooks/math2200/build/null_pvalue-06898a8d5b836b9d69f4776f92753906.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Drag the observed-statistic slider","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rI0VNSvusi"}],"key":"SedqH8oVt6"},{"type":"text","value":" below. The blue histogram is a ","position":{"start":{"line":3,"co