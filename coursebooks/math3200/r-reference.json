:1}},"children":[{"type":"emphasis","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Distribution functions follow the pattern: ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"oLbyEXo15r"},{"type":"inlineCode","value":"d","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"lZP8Pjt2n1"},{"type":"text","value":" = PMF/PDF, ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"uYRwrhALo7"},{"type":"inlineCode","value":"p","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"YXOJaeZ7VO"},{"type":"text","value":" = CDF, ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"YfDTZVXrBX"},{"type":"inlineCode","value":"q","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"B72VS9gVm5"},{"type":"text","value":" = quantile, ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"S48dSKAL8p"},{"type":"inlineCode","value":"r","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"KEIX08oYPO"},{"type":"text","value":" = random generation.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"fF24eLXSbl"}],"key":"hnhoObmVr9"}],"key":"KHbsGnt2xa"},{"type":"code","lang":"r","value":"# Binomial: X ~ Bin(n, p)\ndbinom(x, size = n, prob = p)    # P(X = x)\npbinom(x, size = n, prob = p)    # P(X ≤ x)\nrbinom(nsim, size = n, prob = p) # random generation\n\n# Poisson: X ~ Pois(λ)\ndpois(x, lambda)\nppois(x, lambda)\nrpois(nsim, lambda)\n\n# Normal: X ~ N(μ, σ²)\ndnorm(x, mean, sd)\npnorm(x, mean, sd)\nqnorm(p, mean, sd)    # inverse CDF\nrnorm(nsim, mean, sd)\n\n# Exponential: X ~ Exp(λ)\ndexp(x, rate)\npexp(x, rate)\nrexp(nsim, rate)\n\n# Gamma: X ~ Gamma(α, β)\ndgamma(x, shape = alpha, rate = 1/beta)\npgamma(x, shape = alpha, rate = 1/beta)\nrgamma(nsim, shape = alpha, rate = 1/beta)\n\n# Beta: X ~ Beta(α, β)\ndbeta(x, shape1 = alpha, shape2 = beta)\nrbeta(nsim, shape1 = alpha, shape2 = beta)\n\n# Uniform: X ~ Unif(a, b)\ndunif(x, min = a, max = b)\nrunif(nsim, min = a, max = b)\n\n# Geometric: X ~ Geom(p)\ndgeom(x, prob = p)     # P(X = x), where X = # failures before 1st success\nrgeom(nsim, prob = p)\n\n# Hypergeometric: X ~ Hyper(N, K, n)\ndhyper(x, m = K, n = N-K, k = n)\nrhyper(nsim, m = K, n = N-K, k = n)\n\n# Negative Binomial: X ~ NegBin(r, p)\ndnbinom(x, size = r, prob = p)  # X = # failures before r-th success\nrnbinom(nsim, size = r, prob = p)","position":{"start":{"line":70,"column":1},"end":{"line":116,"column":1}},"key":"xCUp4vap59"},{"type":"heading","depth":2,"position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"text","value":"Simulation (All Chapters)","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"hUNwkDkLDq"}],"identifier":"simulation-all-chapters","label":"Simulation (All Chapters)","html_id":"simulation-all-chapters","implicit":true,"enumerator":"6","key":"slzdK9u8bc"},{"type":"code","lang":"r","value":"set.seed(42)           # for reproducibility\nreplicate(10000, expr) # repeat an expression 10,000 times\nsample(x, size, replace = TRUE)  # sample with replacement","position":{"start":{"line":120,"column":1},"end":{"line":124,"column":1}},"key":"ZSBlnm0UA6"}],"key":"DFMCFtESQG"}],"key":"REvzs4foFl"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Formula Sheet","url":"/formulas","group":"Appendices"},"next":{"title":"Statistical Tables","url":"/tables","group":"Appendices"}}},"domain":"http://localhost:3000"}